{
  "name": "mehmory",
  "version": "0.4.0",
  "type": "module",
  "description": "Memory abstraction layer for Claude Code and Codex CLI",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elderfo/mehmory.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mehmory": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    "assets",
    "VERSION",
    "plugin.json",
    ".claude-plugin"
  ],
  "exports": {
    "./core/home": "./dist/core/home.js",
    "./core/errors": "./dist/core/errors.js",
    "./core/fs": "./dist/core/fs.js",
    "./core/lock": "./dist/core/lock.js",
    "./core/git": "./dist/core/git.js",
    "./core/queue": "./dist/core/queue.js",
    "./core/identity": "./dist/core/identity.js",
    "./core/config": "./dist/core/config.js",
    "./core/cursor": "./dist/core/cursor.js",
    "./core/session": "./dist/core/session.js",
    "./core/inbox": "./dist/core/inbox.js",
    "./core/decay": "./dist/core/decay.js",
    "./core/stats": "./dist/core/stats.js",
    "./core/match": "./dist/core/match.js",
    "./core/store": "./dist/core/store.js",
    "./core/redact": "./dist/core/redact.js",
    "./core/tokens": "./dist/core/tokens.js",
    "./core/injection": "./dist/core/injection.js",
    "./core/scopes": "./dist/core/scopes.js",
    "./schema/format": "./dist/schema/format.js",
    "./transcript/reader": "./dist/transcript/reader.js",
    "./distill/patterns": "./dist/distill/patterns.js",
    "./distill/distill": "./dist/distill/distill.js"
  },
  "scripts": {
    "clean:hooks": "node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('hooks'))if(f.endsWith('.mjs'))fs.rmSync('hooks/'+f)\"",
    "build": "pnpm run clean:hooks && tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docs:dev": "vitepress dev site",
    "docs:build": "vitepress build site",
    "docs:preview": "vitepress preview site",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "tsup": "^8.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.6.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.5"
  },
  "allowScripts": {

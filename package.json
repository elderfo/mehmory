    "file:../../focus-trap@7.8.0/node_modules/focus-trap": true,
    "file:../../acorn@8.17.0/node_modules/acorn": true,
    "file:../../eslint-visitor-keys@3.4.3/node_modules/eslint-visitor-keys": true,
    "file:../../globals@14.0.0/node_modules/globals": true,
    "file:../../../@humanfs+core@0.19.2/node_modules/@humanfs/core": true,
    "file:../../../@humanfs+types@0.15.0/node_modules/@humanfs/types": true,
    "file:../../pathval@2.0.1/node_modules/pathval": true,
    "file:../../ts-api-utils@2.5.0_typescript@5.9.3/node_modules/ts-api-utils": true,
    "file:../../minimatch@10.2.6/node_modules/minimatch": true,
    "file:../../tabbable@6.5.0/node_modules/tabbable": true,
    "file:../../esbuild@0.21.5/node_modules/esbuild": true,
    "file:../../preact@10.29.7/node_modules/preact": true,
    "file:../../keyv@4.5.4/node_modules/keyv": true,
    "file:../../brace-expansion@5.0.8/node_modules/brace-expansion": true,
    "file:../../../@algolia+autocomplete-preset-algolia@1.17.7_@algolia+client-search@5.56.0_algoliasearch@5.56.0/node_modules/@algolia/autocomplete-preset-algolia": true,
    "file:../../../@algolia+autocomplete-core@1.17.7_@algolia+client-search@5.56.0_algoliasearch@5.56.0_search-insights@2.17.3/node_modules/@algolia/autocomplete-core": true,
